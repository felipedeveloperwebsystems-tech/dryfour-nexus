# ============================================================
# DRYFOUR NEXUS — .gitignore  (Vercel-ready)
# ============================================================

# ── Variáveis de ambiente — NUNCA commitar com valores reais ──
.env
.env.local
.env.production
.env.*.local

# ── Vercel CLI ──
.vercel/

# ── Binários Go ──
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/dist/
nexus
nexus.exe

# ── Go test cache ──
*.test
*.prof
/tmp/

# ── Editores ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log

.vercel
